{
  "name": "smru-examos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "migrate": "npm run migrate -w @examos/db",
    "migrate:rollback": "npm run migrate:rollback -w @examos/db",
    "seed": "npm run seed -w @examos/db",
    "dev": "npm run dev -w @examos/api",
    "worker": "npm run worker -w @examos/api",
    "test": "npm run test -w @examos/api -- --run",
    "lint": "eslint .",
    "demo": "npm run demo -w @examos/api",
    "package": "bash scripts/package.sh",
    "security:audit": "npm audit --omit=dev",
    "security:probes": "npm run security:probes -w @examos/api",
    "smoke": "npm run smoke -w @examos/api"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "@types/node": "^22.7.0"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
}
