NODE_ENV=development
PORT=4000
# application role (non-superuser, RLS enforced)
DATABASE_URL=postgres://examos_app:examos_app@127.0.0.1:5432/examos_dev
# owner/admin role for migrations only
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/examos_dev
EXAMOS_APP_DB_PASSWORD=examos_app
REDIS_URL=redis://127.0.0.1:6379/0
JWT_ISSUER=https://examos.smru.edu.in
JWT_AUDIENCE=examos-api
# PEM strings; generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem && openssl rsa -in jwt.pem -pubout -out jwt.pub
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KID=examos-k1
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TTL_SECONDS=43200
# 32-byte hex key for AES-256-GCM at-rest encryption of webhook secrets / sealed config secrets
APP_ENCRYPTION_KEY=
# bootstrap credential for POST /api/v1/platform/tenants (replace with platform admin accounts before production)
PLATFORM_BOOTSTRAP_KEY=
PUBLIC_PORTAL_URL=https://exam.smru.edu.in
ACTIVATION_TTL_HOURS=48
ADMISSION_GRANT_TTL_SECONDS=300
LOG_LEVEL=info
